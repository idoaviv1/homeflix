#!/usr/bin/env bash
# ============================================
# Omflix Management CLI
# ============================================

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
COMPOSE_FILE="$SCRIPT_DIR/docker-compose.yml"
ENV_FILE="$SCRIPT_DIR/.env"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color
BOLD='\033[1m'

log() { echo -e "${GREEN}[omflix]${NC} $1"; }
warn() { echo -e "${YELLOW}[omflix]${NC} $1"; }
error() { echo -e "${RED}[omflix]${NC} $1"; }
header() {
  echo -e ""
  echo -e "${RED}${BOLD}  ⊙ OMFLIX${NC}"
  echo -e "${CYAN}  Your Private Cinema${NC}"
  echo -e ""
}

# Load .env if available
if [ -f "$ENV_FILE" ]; then
  set -a
  source "$ENV_FILE"
  set +a
fi

PUBLIC_PORT="${PUBLIC_PORT:-8096}"
ADMIN_PORT="${ADMIN_PORT:-8097}"

case "${1:-help}" in
  up)
    header
    log "Starting Omflix services..."
    docker compose -f "$COMPOSE_FILE" --env-file "$ENV_FILE" up -d
    log "Waiting for services to be healthy..."
    sleep 3

    # Start the server
    cd "$SCRIPT_DIR"
    if [ -f "apps/server/dist/main.js" ]; then
      log "Starting Omflix server..."
      node apps/server/dist/main.js &
      echo $! > "$SCRIPT_DIR/.omflix.pid"
    else
      warn "Server not built. Run './omflix build' first or use './omflix dev' for development."
    fi

    log "Omflix is running!"
    echo ""
    log "  Public:  http://0.0.0.0:${PUBLIC_PORT}"
    log "  Admin:   http://127.0.0.1:${ADMIN_PORT}"
    echo ""
    ;;

  down)
    header
    log "Stopping Omflix services..."
    if [ -f "$SCRIPT_DIR/.omflix.pid" ]; then
      kill "$(cat "$SCRIPT_DIR/.omflix.pid")" 2>/dev/null || true
      rm -f "$SCRIPT_DIR/.omflix.pid"
    fi
    docker compose -f "$COMPOSE_FILE" --env-file "$ENV_FILE" down
    log "Omflix stopped."
    ;;

  restart)
    header
    log "Restarting Omflix..."
    "$0" down
    sleep 2
    "$0" up
    ;;

  dev)
    header
    log "Starting Omflix in development mode..."

    # Start Docker services (DB + Redis)
    docker compose -f "$COMPOSE_FILE" --env-file "$ENV_FILE" up -d
    log "Waiting for PostgreSQL and Redis..."
    sleep 3

    # Push schema to database
    log "Syncing database schema..."
    cd "$SCRIPT_DIR"
    pnpm --filter @omflix/database db:push 2>/dev/null || warn "Schema push skipped (may need to build packages first)"

    # Start development servers
    log "Starting development servers..."
    pnpm turbo run dev --parallel
    ;;

  build)
    header
    log "Building Omflix..."
    cd "$SCRIPT_DIR"
    pnpm build
    log "Build complete."
    ;;

  status)
    header
    log "Checking Omflix status..."
    echo ""

    # Docker services
    docker compose -f "$COMPOSE_FILE" ps 2>/dev/null || warn "Docker services not running"
    echo ""

    # Server health
    if curl -sf "http://localhost:${PUBLIC_PORT}/api/v1/health" > /dev/null 2>&1; then
      log "Public API:  ${GREEN}✓ Running${NC} on port ${PUBLIC_PORT}"
    else
      warn "Public API:  ✗ Not running on port ${PUBLIC_PORT}"
    fi

    if curl -sf "http://127.0.0.1:${ADMIN_PORT}/api/v1/admin/health" > /dev/null 2>&1; then
      log "Admin API:   ${GREEN}✓ Running${NC} on port ${ADMIN_PORT} (localhost only)"
    else
      warn "Admin API:   ✗ Not running on port ${ADMIN_PORT}"
    fi
    echo ""
    ;;

  logs)
    docker compose -f "$COMPOSE_FILE" logs -f --tail=100 "${2:-}"
    ;;

  update)
    header
    log "Updating Omflix..."
    cd "$SCRIPT_DIR"
    git pull
    pnpm install
    pnpm build
    "$0" restart
    ;;

  scan)
    log "Triggering library scan..."
    curl -sf "http://localhost:${PUBLIC_PORT}/api/v1/library/scan" -X POST || error "Failed to trigger scan"
    ;;

  *)
    header
    echo -e "  ${BOLD}Usage:${NC} ./omflix <command>"
    echo ""
    echo -e "  ${BOLD}Commands:${NC}"
    echo -e "    ${CYAN}up${NC}        Start Omflix (production)"
    echo -e "    ${CYAN}down${NC}      Stop Omflix"
    echo -e "    ${CYAN}restart${NC}   Restart Omflix"
    echo -e "    ${CYAN}dev${NC}       Start in development mode"
    echo -e "    ${CYAN}build${NC}     Build all packages"
    echo -e "    ${CYAN}status${NC}    Check service status"
    echo -e "    ${CYAN}logs${NC}      View Docker logs (optionally specify service)"
    echo -e "    ${CYAN}update${NC}    Pull latest, rebuild, restart"
    echo -e "    ${CYAN}scan${NC}      Trigger library scan"
    echo ""
    ;;
esac
