# ==============================================
# Omflix Environment Configuration
# ==============================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ==============================================

# ---- Application ----
NODE_ENV=production
APP_NAME=Omflix
APP_VERSION=0.1.0

# ---- Server ----
# Public API port (accessible from LAN/Tailscale)
PUBLIC_PORT=8096
# Admin API port (localhost only)
ADMIN_PORT=8097
# Public host binding
PUBLIC_HOST=0.0.0.0
# Admin host binding (DO NOT change from 127.0.0.1)
ADMIN_HOST=127.0.0.1

# ---- Database ----
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=omflix
DATABASE_USER=omflix
DATABASE_PASSWORD=CHANGE_ME_GENERATE_A_STRONG_PASSWORD
DATABASE_URL=postgresql://${DATABASE_USER}:${DATABASE_PASSWORD}@${DATABASE_HOST}:${DATABASE_PORT}/${DATABASE_NAME}

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- JWT / Sessions ----
SESSION_SECRET=CHANGE_ME_GENERATE_A_RANDOM_64_CHAR_STRING
JWT_SECRET=CHANGE_ME_GENERATE_ANOTHER_RANDOM_64_CHAR_STRING

# ---- TMDB ----
# Get your API key from https://www.themoviedb.org/settings/api
TMDB_API_KEY=
TMDB_ACCESS_TOKEN=

# ---- Media ----
MEDIA_ROOT=/media/windows/omflix/media
DATA_ROOT=/media/windows/omflix/data

# ---- Transcoding ----
# auto | nvidia | cpu
TRANSCODE_HW_ACCEL=auto
TRANSCODE_CACHE_MAX_GB=50
TRANSCODE_MIN_FREE_DISK_GB=10

# ---- Logging ----
# debug | info | warn | error
LOG_LEVEL=info
